# Copie para .env e preencha:  cp .env.example .env
# O .env fica fora do git. Ele é carregado sozinho ao rodar qualquer laboratório.

# --- Provedores de LLM -------------------------------------------------------------------
# Preencha um ou mais. Sem nenhum, os laboratórios rodam com o provedor "mock":
# respostas roteirizadas, sem rede e sem custo, para ver o fluxo funcionando.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama (modelos locais). Para usar, preencha com http://localhost:11434
OLLAMA_BASE_URL=
# Modelos locais, se quiser trocar os padrões (llama3.2 e nomic-embed-text):
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ordem do fallback entre provedores. Padrão: openai,gemini,openrouter,ollama
# Só entra na cadeia quem tem credencial. Para forçar o mock: LLM_PROVIDERS=mock
# LLM_PROVIDERS=openai,gemini

# --- Infra local (docker compose up -d) --------------------------------------------------
# Usada pelo lab 02. Os valores batem com o docker-compose.yml.
DATABASE_URL=postgresql://labs:labs@localhost:5432/labs
REDIS_URL=redis://localhost:6379

# --- Logs -------------------------------------------------------------------------------
# Nível: debug, info (padrão), warn, error, silent
# LOG_LEVEL=info
# Formato: uma linha legível por evento (padrão) ou JSON por linha
# LOG_FORMAT=json
