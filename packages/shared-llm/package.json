{
  "name": "@labs/shared-llm",
  "version": "0.1.0",
  "private": true,
  "description": "Wrapper unificado de LLM (OpenAI, Gemini, OpenRouter, Ollama) com fallback, Model Tiering, custo estimado e saída validada com Zod.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@labs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --conditions=@labs/source --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@labs/shared-observability": "workspace:*",
    "openai": "^7.57.0",
    "zod": "catalog:"
  }
}
