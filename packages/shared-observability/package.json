{
  "name": "@labs/shared-observability",
  "version": "0.1.0",
  "private": true,
  "description": "Logger estruturado (Pino) com latência, tokens, custo estimado e cache hits de cada chamada de LLM.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@labs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --conditions=@labs/source --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  }
}
